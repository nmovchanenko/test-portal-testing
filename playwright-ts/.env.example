# Base URL for the TestPortal instance under test.
# Local dev default matches TestPortal-backend's default port (see TestPortal-backend/CLAUDE.md).
TESTPORTAL_BASE_URL=http://localhost:3001

# Base URL for the TestPortal client (web app) under test.
# Local dev default matches TestPortal-client's Vite dev server port (see TestPortal-backend/CLAUDE.md).
TESTPORTAL_CLIENT_URL=http://localhost:5173
