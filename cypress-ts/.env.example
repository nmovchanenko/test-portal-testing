# Base URL for the TestPortal-client instance under test.
# Local dev default matches TestPortal-client's Vite dev server port (see CLAUDE.md).
CYPRESS_BASE_URL=http://localhost:5173

# Credentials for an existing, already-approved TestPortal-client user account.
# Signup alone does not activate an account (it starts "pending"), so this
# account must already have been approved by an admin (e.g. created via
# TestPortal-backend's `npm run bootstrap:admin`) before the login example
# test can use it.
CYPRESS_LOGIN_EMAIL=you@ventionteams.com
CYPRESS_LOGIN_PASSWORD=change-me
